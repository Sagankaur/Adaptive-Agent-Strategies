schema_version = "1.4"

[task]
name = "aas/synthetic-python-isolation-preflight"
version = "1.0.0"
authors = []
keywords = ["synthetic", "infrastructure-preflight"]

[metadata]
difficulty = "easy"
category = "infrastructure"

[verifier]
timeout_sec = 120.0
environment_mode = "shared"

[agent]
timeout_sec = 60.0

[environment]
docker_image = "@@IMAGE@@"
network_mode = "no-network"
cpus = 1
memory_mb = 2048
storage_mb = 1024
