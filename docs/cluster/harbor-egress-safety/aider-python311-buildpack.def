Bootstrap: docker
From: buildpack-deps@sha256:772a4d3210ef96e658ca2dd2511461ac8bc623aa5331111249c75a883d8f0e6d

%labels
    org.opencontainers.image.base.name buildpack-deps:jammy
    org.opencontainers.image.base.digest sha256:772a4d3210ef96e658ca2dd2511461ac8bc623aa5331111249c75a883d8f0e6d
    org.opencontainers.image.description Aider Polyglot Python runtime preflight; no task data

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common tmux asciinema curl
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip
    rm -rf /var/lib/apt/lists/*
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    python3 -m pip install --no-cache-dir --upgrade pip
    python3 -m pip install --no-cache-dir 'pytest==8.3.4'
    python3 --version
    python3 -m pip --version
    python3 -m pytest --version
    command -v curl tmux asciinema git gcc make
    dpkg-query -W -f='${Package}=${Version}\n' \
        software-properties-common tmux asciinema curl python3.11 \
        python3.11-venv python3.11-dev python3-pip

%environment
    export TEST_DIR=/tests
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    exec /bin/bash "$@"
